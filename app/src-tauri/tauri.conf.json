{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "e-Fatura Edit",
  "version": "2.21.0",
  "identifier": "com.zaferbilgisayar.efaturaedit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "e-Fatura Dizayn Editörü",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "maximized": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/xslt-transform"],
    "fileAssociations": [
      {
        "ext": ["xslt", "xsl"],
        "name": "XSLT Dizayn Şablonu",
        "description": "e-Fatura / e-Arşiv / e-İrsaliye XSLT dizayn şablonu",
        "mimeType": "application/xslt+xml",
        "role": "Editor"
      },
      {
        "ext": ["xml"],
        "name": "UBL-TR XML Verisi",
        "description": "UBL-TR e-belge XML veri dosyası",
        "mimeType": "application/xml",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

    <FileVersion>2.19.1.0</FileVersion>
    <Authors>Zafer Bilgisayar</Authors>
    <Company>Zafer Bilgisayar</Company>
    <Product>E-Fatura Dizayn Editörü — Core</Product>
    <Description>UI-bağımsız çekirdek: UBL-TR XSLT snippet'leri, örnek XML kataloğu, autocomplete verileri ve platform soyutlamaları. Windows/macOS/Linux üzerinde çalışır.</Description>
    <Copyright>Copyright © 2018–2026 Zafer Bilgisayar</Copyright>
  </PropertyGroup>

</Project>
